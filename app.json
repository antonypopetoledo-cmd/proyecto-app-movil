{
  "expo": {
    "name": "LimaGo",
    "slug": "LimaGo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-image",
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "LimaGo necesita acceso a tu galería para seleccionar fotos de perfil y eventos.",
          "cameraPermission": "LimaGo necesita acceso a tu cámara para tomar fotos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "LimaGo usa tu ubicación para mostrarte la distancia y ruta hacia los eventos en Lima."
        }
      ]
    ]
  }
}
